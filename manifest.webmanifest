{
  "name": "Private Scale",
  "short_name": "Private",
  "description": "Track your weight, set reminders and see your trend by day, week, month and year. Your data stays on your phone.",
  "lang": "en",
  "dir": "ltr",
  "start_url": ".",
  "scope": ".",
  "id": "afvalapp",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0b1220",
  "theme_color": "#059669",
  "categories": [
    "health",
    "lifestyle",
    "fitness"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add your weight",
      "short_name": "Weigh in",
      "url": "./?quick=1",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "View chart",
      "short_name": "Chart",
      "url": "./?view=chart",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
